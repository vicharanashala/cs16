# MongoDB
MONGO_URI=mongodb://localhost:27017/faqapp

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=5000
NODE_ENV=development

# App URL (used for email links)
APP_URL=http://localhost:5173

# FAQ.txt path (optional)
# Default: cs16/FAQ.txt (project root)
# If your FAQ.txt is elsewhere, set this to the absolute or relative path
# Example: FAQ_TXT_PATH=/home/user/faq-data/FAQ.txt
# Or relative: FAQ_TXT_PATH=../faq-files/FAQ.txt
FAQ_TXT_PATH=

# Set to "true" ONLY when you want to wipe and reseed the database
# Without this flag, `npm run seed` is safe — it only ensures admin exists
RESET_DB=false

# Format: smtps://user:password@smtp.example.com:465
# Leave empty for development (emails print to server console)
SMTP_URL=
SMTP_FROM=noreply@faqapp.local